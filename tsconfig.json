{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ES2022",
		"moduleResolution": "bundler",
		"strict": true,
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM"],
		"paths": {
			"@luna/lib": ["./node_modules/@luna/lib/src/index.ts"],
			"@luna/core": ["./node_modules/@luna/core/src/index.ts"]
		},
		"skipLibCheck": true
	},
	"include": ["src/**/*"]
}
